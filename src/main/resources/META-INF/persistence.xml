<persistence xmlns="https://jakarta.ee/xml/ns/persistence" version="3.1">
	<persistence-unit name="pet-bem-estar">


		<class>br.edu.ifrs.petbemestar.dominio.Tutor</class>
		<class>br.edu.ifrs.petbemestar.dominio.Pet</class>
		<class>br.edu.ifrs.petbemestar.dominio.Atendimento</class>

		<properties>
			<property name="jakarta.persistence.jdbc.driver"
				value="com.mysql.cj.jdbc.Driver" />
			<property name="jakarta.persistence.jdbc.url"
				value="jdbc:mysql://localhost:3306/petbemestar?useSSL=false&amp;serverTimezone=UTC" />
			<property name="jakarta.persistence.jdbc.user" value="root" />
			<property name="jakarta.persistence.jdbc.password"
				value="" />
			<property name="hibernate.hbm2ddl.auto" value="update" />
			<property name="hibernate.show_sql" value="true" />
			<property name="hibernate.format_sql" value="true" />
		</properties>
	</persistence-unit>
</persistence>